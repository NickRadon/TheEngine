TheEngineRig 2
# AE Master / Assets/AE AK reference. Assign to the Quantum body Animator.
# Virtual helpers are not skinned. The head-parented weapon helper carries both grip targets.
bone "vb_ak_weapon" "head" 0 0 0 0 0 0 1
bone "vb_ak_hand_l" "vb_ak_weapon" 0 0 0 0 0 0 1
bone "vb_ak_hand_r" "vb_ak_weapon" 0 0 0 0 0 0 1
# Capture the authored AK weapon and IK hands before the spine/head look pass.
precopy "vb_ak_weapon" "ik_hand_gun" 1 1 1 1
precopy "vb_ak_hand_l" "ik_hand_l" 1 1 1 1
precopy "vb_ak_hand_r" "ik_hand_r" 1 1 1 1
# The inherited head rotation carries the weapon and grips; then solve the arms.
twobone "hand_l" "vb_ak_hand_l" "" 1
twobone "hand_r" "vb_ak_hand_r" "" 1
