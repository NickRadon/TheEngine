TheEngineRig 2
# AE Master / Assets/AE AK reference. Assign to the Quantum body Animator.
# Virtual helpers are not skinned. The head-parented weapon helper carries both grip targets.
bone "vb_ak_weapon" "head" 0 0 0 0 0 0 1
bone "vb_ak_hand_l" "vb_ak_weapon" 0 0 0 0 0 0 1
bone "vb_ak_hand_r" "vb_ak_weapon" 0 0 0 0 0 0 1
# Capture the authored AK weapon before the spine/head look pass.
precopy "vb_ak_weapon" "ik_hand_gun" 1 1 1 1
# Correct the imported weapon frame in its copied local axes before look, sway and arm IK.
prerotate "vb_ak_weapon" "vb_ak_weapon" 0 0.7071068 0.7071068 0
# Copy the authored hand targets after the weapon offset so their neutral model-space
# grip positions stay anchored; the later spine look carries all three helpers together.
precopy "vb_ak_hand_l" "ik_hand_l" 1 1 1 1
precopy "vb_ak_hand_r" "ik_hand_r" 1 1 1 1
# The inherited head rotation carries the weapon and grips; then solve the arms.
# The authored off-hand grip is just beyond the FK arm's reach. Roll the left
# clavicle forward about the upper spine so the shoulder can follow the rifle.
modify "clavicle_l" "spine_05" 0 0 0 -0.16844 -0.04220 0 0.9848078 1
twobone "hand_l" "vb_ak_hand_l" "" 1
twobone "hand_r" "vb_ak_hand_r" "" 1
