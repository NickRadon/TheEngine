<Project Sdk="Microsoft.NET.Sdk">
  <!-- Engine scripting API (Unity-style). Hosted by TheEngine through hostfxr; user scripts reference this assembly. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TheEngine</RootNamespace>
    <AssemblyName>TheEngine.ScriptCore</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>CS1591;CS1668</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- CMake builds with an intermediate folder under build/; ignore output of direct `dotnet build` runs here. -->
    <Compile Remove="bin/**;obj/**" />
  </ItemGroup>
</Project>
